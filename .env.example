# ==============================================================================
# VARIABLES DE ENTORNO — MedSys-FHIR
# Configuración del entorno de desarrollo para persistencia relacional y API Axum
# ==============================================================================

# PostgreSQL 16 (Esquema legado sintético NOM-004-SSA3-2012)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medsys_legacy
POSTGRES_USER=medsys_user
POSTGRES_PASSWORD=medsys_secure_pass_2026

# Cadena de conexión canónica para SQLx (crates/medsys-db)
DATABASE_URL=postgres://medsys_user:medsys_secure_pass_2026@localhost:5432/medsys_legacy

# Configuración del Servidor HTTP Axum (crates/medsys-server)
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# Telemetría y Registro estructurado (Tracing)
RUST_LOG=info,medsys_server=debug,medsys_db=debug
