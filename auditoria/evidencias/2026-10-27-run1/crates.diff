+    let row = sqlx::query("SELECT NULL::text AS absent_value, 'present'::text AS present_value")
+        .fetch_one(manager.pool())
+        .await
+        .unwrap();
+    let values = medsys_db::pg_row_to_json_map(&row).unwrap();
+    assert!(values["absent_value"].is_null());
